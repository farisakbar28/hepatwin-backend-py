# HepaTwin Backend — Environment Template
# Salin ke .env untuk pengembangan lokal; untuk Koyeb set variabel yang
# sama di dashboard (Service > Variables).

BACKEND_CORS_ORIGINS=["*"]
# Untuk produksi final, ganti dengan origin frontend eksplisit,
# mis. ["https://hepatwin.vercel.app"]. Perhatikan: allow_credentials
# otomatis nonaktif bila "*" dipakai (lihat app/main.py).

AI_MODEL_PATH="app/models/model_gatnn_dnn.pt"

# DEBUG=True menambahkan timing_ms per-tahap pada response /api/v1/simulate.
# Set False di produksi (Koyeb).
DEBUG=False

SUPABASE_URL=https://xxxxxxxx.supabase.co

SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxx

SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxx

DATABASE_URL=postgresql://postgres:[PASSWORD]@db.xxxxxxxxx.supabase.co:5432/postgres